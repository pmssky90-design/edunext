{
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "output",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.edunext.kr"
        }
      ],
      "destination": "https://edunext.kr/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)/index.html",
      "destination": "/$1/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
